<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.prep</groupId>
    <artifactId>katalon-prep</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Katalon interview prep - practice workspace</name>

    <!--
      release=21 co y do: Katalon dung Java 21 (xac nhan qua JD + project RCI cua ban cung Java 21).
      May ban dang chay JDK 25 -> van compile duoc, nhung compiler se CHAN moi API sau Java 21.
      Nho vay ban khong vo tinh hoc/dung API ma Katalon khong co.
    -->
    <modules>
        <module>00-refresher-java21</module>
        <module>01-clean-code-solid</module>
        <module>02-quarkus-service</module>
        <module>03-spring-boot-compare</module>
        <module>04-concurrency</module>
        <module>05-postgres-depth</module>
        <module>06-distributed-resilience</module>
        <module>07-dsa-drill</module>
        <module>08-system-design</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.3</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <!--
                          -parameters: giu TEN THAM SO trong bytecode.
                          Spring MVC can no cho @PathVariable/@RequestParam khong ghi ten tuong minh;
                          thieu no thi loi luc CHAY: "Name for argument of type [Long] not specified,
                          and parameter name information not available via reflection".
                          spring-boot-starter-parent bat san cai nay - nhung parent cua ta la
                          katalon-prep, nen phai tu bat. Day la bay rat pho bien khi khong dung
                          starter-parent cua Spring Boot.
                        -->
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
